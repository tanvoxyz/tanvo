      "event": {"code": "test_code", "timestamp": 1700000000, "properties": {"value": "invalid_value", "units": "2"}},
      "error": {"kind": "expected_decimal", "message": "Expected a decimal"}
    },
    {
      "source": "spec/services/billable_metrics/evaluate_expression_service_spec.rb:94",
      "name": "evaluate expression fails for a missing event (invalid_event)",
