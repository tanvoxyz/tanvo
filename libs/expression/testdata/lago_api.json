    {
      "source": "spec/services/billable_metrics/evaluate_expression_service_spec.rb:21",
      "name": "evaluate expression returns the result of the evaluated expression",
      "note": "The service turns every property into a string (transform_values(&:to_s)).",
      "expression": "round(event.properties.value * event.properties.units)",
      "event": {"code": "test_code", "timestamp": 1700000000, "properties": {"value": "10.4", "units": "2"}},
      "number": "21"
    },
    {
      "source": "spec/services/billable_metrics/evaluate_expression_service_spec.rb:43",
