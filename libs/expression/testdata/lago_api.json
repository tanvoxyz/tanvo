    },
    {
      "source": "spec/services/billable_metrics/evaluate_expression_service_spec.rb:61",
      "name": "evaluate expression returns the event's timestamp",
      "note": "lago-api falls back to Time.current when the event has no timestamp; the caller of the Go host chooses the time.",
      "expression": "event.timestamp",
      "event": {"code": "test_code", "timestamp": 1700000000, "properties": {}},
      "number": "1700000000"
    },
    {
      "source": "spec/services/billable_metrics/evaluate_expression_service_spec.rb:83",
