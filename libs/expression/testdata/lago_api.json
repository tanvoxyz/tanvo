      "expression": "round(event.properties.value * event.properties.units)",
      "event": {"code": "", "timestamp": 0, "properties": {}},
      "error": {"kind": "missing_variable", "message": "Variable: value not found"}
    },
    {
      "source": "spec/requests/api/v1/billable_metrics_controller_spec.rb:310",
      "name": "the evaluate_expression endpoint evaluates the expression",
