{
  "name": "expression",
  "targets": {
    "wasm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build-wasm.mjs",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["rust", "{projectRoot}/scripts/build-wasm.mjs", { "env": "RUSTFLAGS" }],
      "outputs": ["{projectRoot}/go/expression.wasm"]
    }
  }
}
