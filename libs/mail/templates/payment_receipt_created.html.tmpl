{{define "content"}}
<table cellpadding="0" cellspacing="0" style="margin: auto; padding-bottom: 24px">
<tr><td style="color: #66758f; font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: center;">{{.L.T "email.payment_receipt.created.payment_receipt_from" "billing_entity_name" .D.BillingEntityName}}</td></tr>
<tr><td style="color: #19212e; font-size: 32px; font-weight: 700; line-height: 40px; letter-spacing: 0em; text-align: center;">{{.D.Amount}}</td></tr>
<tr><td style="color: #66758f; font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: center;">{{.L.T "payment_receipt.paid_on" "date" .D.PaymentDate "total_due_amount" .D.TotalDue}}</td></tr>
</table>
<table style="width: 100%; border-collapse: collapse; border-top: 1px solid #d9dee7;">
<tr><td style="color: #66758f; font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: left; white-space: nowrap; padding: 4px 0;">{{.L.T "payment_receipt.number"}}</td><td style="font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: right; color: #19212e; white-space: nowrap; padding: 4px 0;">{{.D.Number}}</td></tr>
<tr><td style="color: #66758f; font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: left; white-space: nowrap; padding: 4px 0;">{{.L.T "payment_receipt.payment_date"}}</td><td style="font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: right; color: #19212e; white-space: nowrap; padding: 4px 0;">{{.D.PaymentDate}}</td></tr>
<tr><td style="color: #66758f; font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: left; white-space: nowrap; padding: 4px 0;">{{.L.T "invoice.total_paid_amount"}}</td><td style="font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: right; color: #19212e; white-space: nowrap; padding: 4px 0;">{{.D.Amount}}</td></tr>
</table>
<table style="width: 100%; border-collapse: collapse; border-bottom: 1px solid #d9dee7; margin-top: 32px;">
<tr><td style="font-size: 14px; font-weight: bold; line-height: 20px; text-align: left; color: #19212E; white-space: nowrap; padding: 0;">{{.L.T "email.invoice.finalized.invoice_number"}}</td><td style="font-size: 14px; font-weight: bold; line-height: 20px; text-align: right; color: #19212E; white-space: nowrap; padding: 0;">{{.L.T "invoice.total"}}</td></tr>
{{- range .D.Invoices}}
<tr style="border-bottom: 1px solid #d9dee7;"><td style="font-size: 14px; font-weight: 400; line-height: 20px; text-align: left; padding-right: 16px; white-space: nowrap; padding: 8px 0;">{{if and $.PDFs .FileURL}}<a href="{{.FileURL}}" style="text-decoration: none; color: #006cfa">{{.Number}}</a>{{else}}{{.Number}}{{end}}</td><td style="font-size: 14px; font-weight: 400; line-height: 20px; text-align: right; color: #19212e; white-space: nowrap; padding: 8px 0;">{{.Total}}</td></tr>
{{- end}}
</table>
{{- if and .PDFs .D.FileURL}}
<table cellpadding="0" cellspacing="0" style="width: 100%; padding: 24px 0; border-bottom: 1px solid #d9dee7;"><tr><td><table cellpadding="0" cellspacing="0" style="margin: auto"><tr><td style="font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; color: #19212e;"><a style="text-decoration: none; color: #006cfa" target="_blank" href="{{.D.FileURL}}">{{.L.T "payment_receipt.download_receipt"}}</a></td></tr></table></td></tr></table>
{{- end}}
{{end}}
