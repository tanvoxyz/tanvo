{{define "content"}}
<table cellpadding="0" cellspacing="0" style="margin: auto; padding-bottom: 24px">
<tr><td style="color: #66758f; font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: center;">{{.L.T "email.invoice.finalized.invoice_from" "billing_entity_name" .D.BillingEntityName}}</td></tr>
<tr><td style="color: #19212e; font-size: 32px; font-weight: 700; line-height: 40px; letter-spacing: 0em; text-align: center;">{{.D.Total}}</td></tr>
<tr><td style="color: #66758f; font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: center;">{{.L.T "email.invoice.finalized.issued_on" "date" .D.IssuingDate}}</td></tr>
</table>
<table cellpadding="0" cellspacing="0" style="width: 100%; padding: 24px 0; border-top: 1px solid #d9dee7; border-bottom: 1px solid #d9dee7;"><tr><td>
<table cellpadding="0" cellspacing="0" style="width: 100%">
<tr><td style="font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: left; padding-right: 16px; color: #66758f; white-space: nowrap; padding-bottom: 4px;">{{.L.T "email.invoice.finalized.invoice_number"}}</td><td style="font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: right; color: #19212e; white-space: nowrap; padding-bottom: 4px;">{{.D.Number}}</td></tr>
<tr><td style="font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: left; padding-right: 16px; color: #66758f; white-space: nowrap; padding-bottom: 4px;">{{.L.T "email.invoice.finalized.issue_date"}}</td><td style="font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; text-align: right; color: #19212e; white-space: nowrap; padding-bottom: 4px;">{{.D.IssuingDate}}</td></tr>
</table>
</td></tr></table>
{{- if and .PDFs .D.FileURL}}
<table cellpadding="0" cellspacing="0" style="width: 100%; padding: 24px 0; border-bottom: 1px solid #d9dee7;"><tr><td><table cellpadding="0" cellspacing="0" style="margin: auto"><tr><td style="font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0em; color: #19212e;"><a style="text-decoration: none; color: #006cfa" href="{{.D.FileURL}}">{{.L.T "email.invoice.finalized.download"}}</a></td></tr></table></td></tr></table>
{{- end}}
{{end}}
